# Hey MiRo local AI: pinned Hugging Face models (all ungated; no HF login).
# download_models.bash fetches exactly these revisions into the
# heymiro-models volume; the services then run with HF_HUB_OFFLINE=1.
# Format: NAME=repo@revision:file[,file...]   ("*" = whole repo)

# LLM (vision-language; Apache-2.0). 4b = default, 9b = quality profile.
LLM_4B=unsloth/Qwen3.5-4B-GGUF@e87f176479d0855a907a41277aca2f8ee7a09523:Qwen3.5-4B-Q4_K_M.gguf,mmproj-F16.gguf
LLM_9B=unsloth/Qwen3.5-9B-GGUF@3885219b6810b007914f3a7950a8d1b469d598a5:Qwen3.5-9B-Q4_K_M.gguf,mmproj-F16.gguf

# speech-to-text: Whisper large-v3-turbo, CTranslate2 (MIT)
STT=deepdml/faster-whisper-large-v3-turbo-ct2@4df90f75321148c3a29a9e2351b7ddf8f5b115a8:*

# text-to-speech: Kokoro-82M (Apache-2.0)
TTS=hexgrad/Kokoro-82M@f3ff3571791e39611d31c381e3a41a3af07b4987:config.json,kokoro-v1_0.pth,voices/af_heart.pt,voices/af_bella.pt,voices/af_sky.pt,voices/am_michael.pt,voices/bf_emma.pt

# end-of-turn detection: smart-turn v3.2 (BSD-2-Clause), CPU ONNX
TURN=pipecat-ai/smart-turn-v3@f766f81d3cfdf7737ac64aad813d91bbfd56bf93:smart-turn-v3.2-cpu.onnx

# object detection for the scene client (AGPL-3.0, Ultralytics). Not a Hugging
# Face repo: fetched from the Ultralytics release into the heymiro-cache volume
# (the ROS container's $HEYMIRO_CACHE_DIR/weights), so YOLO never downloads at run time.
YOLO=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov10m.pt
