# Hey MiRo - secrets and API routes
#
# Copy this file OUTSIDE the repository and fill in your own keys:
#
#     install -D -m 600 config/secrets.env.example ~/.config/heymiro/secrets.env
#
# docker/run_docker.bash mounts ~/.config/heymiro/secrets.env read-only into
# the container (it never enters the image, git, logs or the ROS master).
#
# Format (docker --env-file rules): KEY=value, no quotes, no "export",
# comments only on their own line. An empty value means "not set": the
# feature that needs it is switched off with a warning.

# --- Language: speech-to-text (Whisper) + chat (GPT) ----------------------------
# Any OpenAI-compatible server works (OpenAI, Azure OpenAI v1 endpoint, a local
# vLLM / Ollama server e.g. http://localhost:11434/v1). Base URL default:
# https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: separate routes for chat and transcription (fall back to OPENAI_*)
HEYMIRO_LLM_BASE_URL=
HEYMIRO_LLM_API_KEY=
HEYMIRO_STT_BASE_URL=
HEYMIRO_STT_API_KEY=

# --- Voice: ElevenLabs text-to-speech ---------------------------------------------
# Base URL default: https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=

# --- Wake words (Porcupine v3) and voice activity detection (Cobra v2) ------------
# Custom .ppn wake words only work with the Picovoice account that trained
# them; set a per-keyword key if yours came from different accounts.
PICOVOICE_ACCESS_KEY=
PICOVOICE_ACCESS_KEY_HEY_MIRO=
PICOVOICE_ACCESS_KEY_DANCE_MIRO=
PICOVOICE_ACCESS_KEY_STOP_MIRO=

# --- Music (optional): Spotify song lookup ------------------------------------------
# Defaults: https://api.spotify.com/v1 and https://accounts.spotify.com/api/token
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_BASE_URL=
SPOTIFY_TOKEN_URL=
